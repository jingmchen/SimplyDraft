#SCRIPT
# ===========================================================================
#  Resume automation
#  -------------------------------------------------------------------------
#  Fields assigned below are filled in for you, so they are NOT asked as
#  questions when you generate a resume from this template:
#
#    * LASTUPDATEDDATE / RESUMEVERSION - stamped from today's date.
#    * RESUMEVARIANT                   - a drop-down (it is a "match" subject).
#                                        Each choice tailors the footer note
#                                        and the references statement.
# ===========================================================================

# Auto-stamp the administrative fields from the system clock.
LASTUPDATEDDATE = format(system.date, "MMMM d, yyyy")
RESUMEVERSION = format(system.date, "yyyy.MM")

# Choose who the resume is for; the wording adjusts to match.
match RESUMEVARIANT:
    case "Public":
        CONFIDENTIALITYNOTE = "Cleared for public distribution."
        REFERENCESSTATEMENT = "References are available on request."
    case "Recruiter":
        CONFIDENTIALITYNOTE = "Shared in confidence for recruitment purposes."
        REFERENCESSTATEMENT = "Detailed references available to hiring teams on request."
    case "Confidential":
        CONFIDENTIALITYNOTE = "Confidential - please do not circulate without written permission."
        REFERENCESSTATEMENT = "References provided on request once mutual interest is confirmed."
    case _:
        CONFIDENTIALITYNOTE = ""
        REFERENCESSTATEMENT = "References are available on request."
#ENDSCRIPT
\begin{center}
\textbf{ {FULLNAME} }

\textbf{ {TARGETJOBTITLE} }

{CITY}, {STATEORREGION}, {COUNTRY}  |  {PHONE}  |  {EMAIL}  |  {LINKEDINURL}  |  {PORTFOLIOURL}

\emph{ {CONFIDENTIALITYNOTE}}
