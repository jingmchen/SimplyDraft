#SCRIPT
# ===========================================================================
#  Video-transcript automation
#  -------------------------------------------------------------------------
#  Fields assigned below are filled in for you, so they are NOT asked as
#  questions when you generate a transcript:
#
#    * TRANSCRIPTIONDATE - stamped from today's date.
#    * The notation markers - one house style, applied in the Conventions
#      table so every transcript uses the same symbols.
#    * TRANSCRIPTSTATUS  - a drop-down (a "match" subject). Each choice also
#      writes the matching delivery note shown under the title.
# ===========================================================================

# Auto-stamp the transcription date.
TRANSCRIPTIONDATE = format(system.date, "yyyy-MM-dd")

# House-style notation markers (edit once here; shown in Transcript Conventions).
TIMESTAMPFORMAT = "[HH:MM:SS]"
SPEAKERFORMAT = "NAME:"
UNCLEARAUDIOMARKER = "(unclear)"
INAUDIBLEMARKER = "(inaudible)"
NONSPEECHAUDIOMARKER = "[non-speech: description]"
MUSICMARKER = "[music]"
ONSCREENTEXTMARKER = "[on-screen: text]"
EDITORIALNOTEMARKER = "[note: editorial]"

# Workflow status drives a matching delivery note under the title.
match TRANSCRIPTSTATUS:
    case "Draft":
        DELIVERYNOTE = "DRAFT - not yet reviewed; do not publish."
    case "In Review":
        DELIVERYNOTE = "In review - pending accuracy and caption QC."
    case "Approved":
        DELIVERYNOTE = "Approved for captioning and publication."
    case _:
        DELIVERYNOTE = ""
#ENDSCRIPT
\begin{center}
\textbf{ VIDEO TRANSCRIPT }

\textbf{ {VIDEOTITLE} }

{SUBTITLEORCAMPAIGNNAME}

\emph{ {DELIVERYNOTE}}
\end{center}


