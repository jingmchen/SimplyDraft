\textbf{Video Filename} & {VIDEOFILENAME} & \textbf{Video Duration} & {VIDEODURATION} \\
\textbf{Recording Date} & {RECORDINGDATE} & \textbf{Transcript Date} & {TRANSCRIPTIONDATE} \\
\textbf{Prepared By} & {PREPAREDBY} & \textbf{Reviewed By} & {REVIEWEDBY} \\
\textbf{Status} & {TRANSCRIPTSTATUS} & \textbf{Language} & {PRIMARYLANGUAGE} \\
\end{tabular}

