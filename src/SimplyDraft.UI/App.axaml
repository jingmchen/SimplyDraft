    <StyleInclude Source="avares://SimplyDraft.UI/Assets/Styles/Base.axaml" />
    <StyleInclude Source="avares://SimplyDraft.UI/Assets/Styles/Buttons.axaml" />
    <StyleInclude Source="avares://SimplyDraft.UI/Assets/Styles/Inputs.axaml" />
    <StyleInclude Source="avares://SimplyDraft.UI/Assets/Styles/Lists.axaml" />
    <StyleInclude Source="avares://SimplyDraft.UI/Assets/Styles/RadioButtons.axaml" />
    <StyleInclude Source="avares://SimplyDraft.UI/Assets/Styles/Surfaces.axaml" />
    <StyleInclude Source="avares://SimplyDraft.UI/Assets/Styles/Datagrids.axaml" />
  </Application.Styles>

