<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SimplyDraft.UI.Views.Dialogs.InputDialog"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Title="SimplyDraft">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
    <TextBox x:Name="Input" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
      <Button Content="OK" IsDefault="True" Click="OnOk" />
    </StackPanel>
  </StackPanel>
</Window>