<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SimplyDraft.UI.Views.Dialogs.NewTemplateDialog"
        Width="440" Height="440"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Title="New template">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
      <Button Content="Create" IsDefault="True" Click="OnCreate" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
      <TextBlock Text="Template name:" />
      <TextBox x:Name="NameInput" />
      <TextBlock x:Name="ErrorText" Classes="errorText" TextWrapping="Wrap" IsVisible="False" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Text="Start from:" Margin="0,0,0,6" />
    <ListBox x:Name="SourceList" SelectionChanged="OnSourcePicked" DoubleTapped="OnDoubleTapped" />
  </DockPanel>
</Window>