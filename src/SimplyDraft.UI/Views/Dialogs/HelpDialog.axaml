<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:SimplyDraft.Core.Domains.UI"
        x:Class="SimplyDraft.UI.Views.Dialogs.HelpDialog"
        Width="820" Height="640" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ThemeBg0Brush}">

  <Window.Resources>

    <!-- One help row: mono code chip · description. -->
    <DataTemplate x:Key="HelpEntryTemplate" x:DataType="dlg:HelpEntry">
      <Grid ColumnDefinitions="260,14,*" Margin="0,4">

        <Border Background="{DynamicResource ThemeBg2Brush}"
                CornerRadius="4"
                Padding="8,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">

          <SelectableTextBlock Text="{Binding Code}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ThemeFg0Brush}" />

        </Border>

        <TextBlock Grid.Column="2"
                   Text="{Binding Description}"
                   TextWrapping="Wrap"
                   FontSize="12.5"
                   Foreground="{DynamicResource ThemeFg1Brush}"
                   VerticalAlignment="Top"
                   Margin="0,4,0,0" />

      </Grid>
    </DataTemplate>

  </Window.Resources>

  <DockPanel Margin="16">

    <Button DockPanel.Dock="Bottom"
            Content="Close"
            HorizontalAlignment="Right"
            MinWidth="90"
            Margin="0,12,0,0"
            IsCancel="True"
            Click="OnClose" />

    <ListBox x:Name="TopicsList"
             DockPanel.Dock="Left"
             Width="190"
             Margin="0,0,12,0"
             SelectionChanged="OnTopicSelected" />

    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
      
        <TextBlock x:Name="TopicTitle"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ThemeFg0Brush}" />

        <TextBlock x:Name="TopicIntro"
                   TextWrapping="Wrap"
                   FontSize="12.5"
                   Foreground="{DynamicResource ThemeFg2Brush}" />

      </StackPanel>

      <Border Classes="card" Padding="14">
        <ScrollViewer>
          <StackPanel>

            <ItemsControl x:Name="EntriesList"
                          ItemTemplate="{StaticResource HelpEntryTemplate}" />

            <TextBlock x:Name="TopicNote"
                       TextWrapping="Wrap"
                       FontSize="12"
                       FontStyle="Italic"
                       Foreground="{DynamicResource ThemeFg2Brush}"
                       Margin="0,10,0,0" />

          </StackPanel>
        </ScrollViewer>
      </Border>
    </DockPanel>
  </DockPanel>
</Window>