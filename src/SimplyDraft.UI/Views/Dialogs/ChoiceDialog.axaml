<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SimplyDraft.UI.Views.Dialogs.ChoiceDialog"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Title="SimplyDraft">
  <StackPanel Margin="16" Spacing="12">
    <ScrollViewer MaxHeight="320">
      <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" />
    </ScrollViewer>
    <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" />
  </StackPanel>
</Window>