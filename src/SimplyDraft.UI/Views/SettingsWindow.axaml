<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SimplyDraft.UI.ViewModels"
        x:Class="SimplyDraft.UI.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Width="620" SizeToContent="Height" MaxHeight="740" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBg0Brush}"
        Title="Settings">

  <ScrollViewer>
    <StackPanel Margin="16" Spacing="16">

      <StackPanel Spacing="4">

        <TextBlock Text="Settings"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ThemeFg0Brush}" />

        <TextBlock Text="Export and generation preferences — applied on Save."
                   Foreground="{DynamicResource ThemeFg2Brush}" />
                  
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="10">

          <TextBlock Text="Export"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ThemeFg0Brush}" />

          <TextBlock Text="DEFAULT EXPORT FORMAT"
                     Classes="paneHeader" />

          <ComboBox ItemsSource="{Binding Formats}"
                    SelectedItem="{Binding DefaultFormat, Mode=TwoWay}"
                    MinWidth="180"
                    HorizontalAlignment="Left" />

          <TextBlock Text="TXT LINE ENDINGS"
                     Classes="paneHeader"
                     Margin="0,6,0,0" />

          <ComboBox ItemsSource="{Binding NewLines}"
                    SelectedItem="{Binding NewLine, Mode=TwoWay}"
                    MinWidth="180"
                    HorizontalAlignment="Left" />

          <CheckBox Content="Write UTF-8 BOM in .txt exports"
                    IsChecked="{Binding TxtBom, Mode=TwoWay}"
                    Margin="0,6,0,0" />

        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">

          <TextBlock Text="Generation"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ThemeFg0Brush}" />

          <TextBlock Text="MISSING VARIABLES"
                     Classes="paneHeader" />

          <ComboBox ItemsSource="{Binding Policies}"
                    SelectedItem="{Binding Policy, Mode=TwoWay}"
                    MinWidth="220"
                    HorizontalAlignment="Left" />

          <TextBlock Text="FORMAT() CULTURE"
                     Classes="paneHeader"
                     Margin="0,6,0,0" />

          <ComboBox ItemsSource="{Binding Cultures}"
                    SelectedItem="{Binding Culture, Mode=TwoWay}"
                    MinWidth="180"
                    HorizontalAlignment="Left" />

        </StackPanel>
      </Border>

      <TextBlock Classes="errorText"
                 Text="{Binding StatusText}"
                 TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      
        <Button Content="Cancel"
                IsCancel="True"
                Click="OnCancel" />

        <Button Content="Save"
                Classes="accent"
                IsDefault="True"
                Click="OnSave" />

      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</Window>