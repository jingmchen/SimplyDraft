<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  BORDER — utility classes                                   -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource ThemeBg1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>
  
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource ThemeBg1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="Border.separator">
    <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="Height" Value="1" />
  </Style>

  <!-- editor pane frame (AvaloniaEdit hosts) -->
  <Style Selector="Border.editorFrame">
    <Setter Property="Background" Value="{DynamicResource ThemeBg2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <!-- the accent-colored status bar -->
  <Style Selector="Border.statusBar">
    <Setter Property="Background" Value="{DynamicResource StatusBarBrush}" />
    <Setter Property="Padding" Value="10,3" />
  </Style>
  <Style Selector="Border.statusBar TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Drag-to-trash zone; DropTargetBehavior toggles "drop-ok" while a valid item hovers. -->
  <Style Selector="Border.dropZone">
    <Setter Property="Background" Value="{DynamicResource ThemeBg2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.dropZone.drop-ok">
    <Setter Property="Background" Value="#3343A047" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeSuccessBrush}" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  GRIDSPLITTER — VS Code-style sash                          -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="#10808080" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="MinHeight" Value="6" />
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentLight1Brush}" />
  </Style>
  <Style Selector="GridSplitter:pressed">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  EXPANDER                                                   -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <Style Selector="Expander">
    <Setter Property="Background" Value="{DynamicResource ThemeBg1Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeFg0Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  SCROLLBAR                                                  -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="ScrollBar /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{DynamicResource ThemeBorderStrongBrush}" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  PROGRESSBAR                                                -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <Style Selector="ProgressBar">
    <Setter Property="Background" Value="{DynamicResource ThemeBg2Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  TOOLTIP                                                    -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource ThemeBg3Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeFg0Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  CONTEXTMENU                                                -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource ThemeBg1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="4" />
  </Style>

</Styles>