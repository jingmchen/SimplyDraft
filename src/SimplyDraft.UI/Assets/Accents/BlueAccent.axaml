<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Fluent ramp (consumed by built-in controls via SystemAccentColor) -->
  <Color x:Key="SystemAccentColor">#007ACC</Color>
  <Color x:Key="SystemAccentColorDark1">#0068AE</Color>
  <Color x:Key="SystemAccentColorDark2">#005691</Color>
  <Color x:Key="SystemAccentColorDark3">#004574</Color>
  <Color x:Key="SystemAccentColorLight1">#1E8AD6</Color>
  <Color x:Key="SystemAccentColorLight2">#3D9AE0</Color>
  <Color x:Key="SystemAccentColorLight3">#5CAAE9</Color>

  <!-- Accent brushes -->
  <SolidColorBrush x:Key="AccentBrush"           Color="#007ACC" />
  <SolidColorBrush x:Key="AccentHoverBrush"      Color="#1E8AD6" />
  <SolidColorBrush x:Key="AccentPressedBrush"    Color="#0068AE" />
  <SolidColorBrush x:Key="AccentLight1Brush"     Color="#1E8AD6" />
  <SolidColorBrush x:Key="AccentDark1Brush"      Color="#0068AE" />
  <SolidColorBrush x:Key="AccentSubtleBrush"     Color="#33007ACC" />
  <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="StatusBarBrush"        Color="#007ACC" />
</ResourceDictionary>