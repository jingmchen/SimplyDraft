<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Fluent ramp (consumed by built-in controls via SystemAccentColor) -->
  <Color x:Key="SystemAccentColor">#6C5CE7</Color>
  <Color x:Key="SystemAccentColorDark1">#5B4BD4</Color>
  <Color x:Key="SystemAccentColorDark2">#4C3EBC</Color>
  <Color x:Key="SystemAccentColorDark3">#3D31A3</Color>
  <Color x:Key="SystemAccentColorLight1">#7D6EF0</Color>
  <Color x:Key="SystemAccentColorLight2">#8F82F5</Color>
  <Color x:Key="SystemAccentColorLight3">#A296F8</Color>

  <!-- Accent brushes -->
  <SolidColorBrush x:Key="AccentBrush"           Color="#6C5CE7" />
  <SolidColorBrush x:Key="AccentHoverBrush"      Color="#7D6EF0" />
  <SolidColorBrush x:Key="AccentPressedBrush"    Color="#5B4BD4" />
  <SolidColorBrush x:Key="AccentLight1Brush"     Color="#7D6EF0" />
  <SolidColorBrush x:Key="AccentDark1Brush"      Color="#5B4BD4" />
  <SolidColorBrush x:Key="AccentSubtleBrush"     Color="#336C5CE7" />
  <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="StatusBarBrush"        Color="#6C5CE7" />
</ResourceDictionary>