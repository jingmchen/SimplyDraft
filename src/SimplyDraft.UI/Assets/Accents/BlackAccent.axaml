<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Fluent ramp (consumed by built-in controls via SystemAccentColor) -->
  <Color x:Key="SystemAccentColor">#111111</Color>
  <Color x:Key="SystemAccentColorDark1">#000000</Color>
  <Color x:Key="SystemAccentColorDark2">#000000</Color>
  <Color x:Key="SystemAccentColorDark3">#000000</Color>
  <Color x:Key="SystemAccentColorLight1">#3A3A3A</Color>
  <Color x:Key="SystemAccentColorLight2">#5C5C5C</Color>
  <Color x:Key="SystemAccentColorLight3">#8A8A8A</Color>

  <!-- Accent brushes -->
  <SolidColorBrush x:Key="AccentBrush"           Color="#111111" />
  <SolidColorBrush x:Key="AccentHoverBrush"      Color="#3A3A3A" />
  <SolidColorBrush x:Key="AccentPressedBrush"    Color="#000000" />
  <SolidColorBrush x:Key="AccentLight1Brush"     Color="#3A3A3A" />
  <SolidColorBrush x:Key="AccentDark1Brush"      Color="#000000" />
  <SolidColorBrush x:Key="AccentSubtleBrush"     Color="#33111111" />
  <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="StatusBarBrush"        Color="#111111" />
</ResourceDictionary>