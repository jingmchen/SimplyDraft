<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Backgrounds (Bg0 pure-white canvas · Bg1 cards · Bg2/Bg3 raised controls) -->
  <SolidColorBrush x:Key="ThemeBg0Brush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeBg1Brush" Color="#FAFAFA" />
  <SolidColorBrush x:Key="ThemeBg2Brush" Color="#F0F0F0" />
  <SolidColorBrush x:Key="ThemeBg3Brush" Color="#E6E6E6" />

  <!-- Foregrounds (Fg0 primary → Fg3 faint) -->
  <SolidColorBrush x:Key="ThemeFg0Brush" Color="#111111" />
  <SolidColorBrush x:Key="ThemeFg1Brush" Color="#3A3A3A" />
  <SolidColorBrush x:Key="ThemeFg2Brush" Color="#767676" />
  <SolidColorBrush x:Key="ThemeFg3Brush" Color="#A0A0A0" />

  <!-- Borders -->
  <SolidColorBrush x:Key="ThemeBorderBrush"       Color="#DDDDDD" />
  <SolidColorBrush x:Key="ThemeBorderStrongBrush" Color="#C8C8C8" />

  <!-- Interaction fills -->
  <SolidColorBrush x:Key="ThemeHoverBrush"    Color="#ECECEC" />
  <SolidColorBrush x:Key="ThemePressedBrush"  Color="#E2E2E2" />
  <SolidColorBrush x:Key="ThemeSelectedBrush" Color="#E6E9EF" />

  <!-- Status -->
  <SolidColorBrush x:Key="ThemeErrorBrush"   Color="#C0392B" />
  <SolidColorBrush x:Key="ThemeWarningBrush" Color="#B7791F" />
  <SolidColorBrush x:Key="ThemeSuccessBrush" Color="#2E7D5B" />
  <SolidColorBrush x:Key="ThemeInfoBrush"    Color="#1F6FBB" />

  <!-- Overlay / scrim -->
  <SolidColorBrush x:Key="ThemeOverlayBrush" Color="#66000000" />
</ResourceDictionary>