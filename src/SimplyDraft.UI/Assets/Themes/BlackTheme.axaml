<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Backgrounds (Bg0 base canvas -> Bg3 elevated / hover) -->
  <SolidColorBrush x:Key="ThemeBg0Brush" Color="#1A1A1A" />
  <SolidColorBrush x:Key="ThemeBg1Brush" Color="#242424" />
  <SolidColorBrush x:Key="ThemeBg2Brush" Color="#2E2E2E" />
  <SolidColorBrush x:Key="ThemeBg3Brush" Color="#383838" />

  <!-- Foregrounds (Fg0 primary -> Fg3 faint) -->
  <SolidColorBrush x:Key="ThemeFg0Brush" Color="#F0F0F0" />
  <SolidColorBrush x:Key="ThemeFg1Brush" Color="#C8C8C8" />
  <SolidColorBrush x:Key="ThemeFg2Brush" Color="#999999" />
  <SolidColorBrush x:Key="ThemeFg3Brush" Color="#6E6E6E" />

  <!-- Borders -->
  <SolidColorBrush x:Key="ThemeBorderBrush"       Color="#444444" />
  <SolidColorBrush x:Key="ThemeBorderStrongBrush" Color="#565656" />

  <!-- Interaction fills -->
  <SolidColorBrush x:Key="ThemeHoverBrush"    Color="#2F2F2F" />
  <SolidColorBrush x:Key="ThemePressedBrush"  Color="#1F1F1F" />
  <SolidColorBrush x:Key="ThemeSelectedBrush" Color="#424242" />

  <!-- Status -->
  <SolidColorBrush x:Key="ThemeErrorBrush"   Color="#EF5350" />
  <SolidColorBrush x:Key="ThemeWarningBrush" Color="#E5A93D" />
  <SolidColorBrush x:Key="ThemeSuccessBrush" Color="#57C08A" />
  <SolidColorBrush x:Key="ThemeInfoBrush"    Color="#4F9BEF" />

  <!-- Overlay / scrim -->
  <SolidColorBrush x:Key="ThemeOverlayBrush" Color="#99000000" />
</ResourceDictionary>